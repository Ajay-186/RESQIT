# ResQNet AI Backend Configuration

PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqnet_db?retryWrites=true&w=majority

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for Authenticated Roles
JWT_SECRET=super_secret_resqnet_jwt_token_2026

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=resqnet-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@resqnet-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://resqnet-ai.vercel.app
